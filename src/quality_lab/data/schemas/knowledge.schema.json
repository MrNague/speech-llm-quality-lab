{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "doc_id",
    "doc_version",
    "passage_id",
    "title",
    "text",
    "source_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_version": {
      "type": "string",
      "minLength": 1
    },
    "passage_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
