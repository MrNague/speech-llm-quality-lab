{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "branch",
    "status",
    "raw_output",
    "parsed_output",
    "elapsed_s",
    "error_code",
    "retrieved_passage_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "success",
        "timeout",
        "inference_error",
        "invalid_output",
        "skipped"
      ]
    },
    "raw_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "parsed_output": {
      "type": [
        "object",
        "null"
      ]
    },
    "elapsed_s": {
      "type": "number",
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_passage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rss_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
