{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "code_commit",
    "dataset_hash",
    "kb_hash",
    "config_hash",
    "model_id",
    "model_revision",
    "prompt_hash",
    "normalization_version",
    "environment",
    "cost_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "created",
        "validated",
        "running",
        "completed",
        "partial",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "code_commit": {
      "type": "string",
      "minLength": 1
    },
    "dataset_hash": {
      "type": "string",
      "minLength": 1
    },
    "kb_hash": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "prompt_hash": {
      "type": "string",
      "minLength": 1
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object"
    },
    "cost_status": {
      "type": "string",
      "minLength": 1
    },
    "model_files_hash": {
      "type": "string"
    },
    "planned": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "model_load_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "load_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
